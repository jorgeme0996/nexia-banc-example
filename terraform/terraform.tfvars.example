# Copia este archivo:  cp terraform.tfvars.example terraform.tfvars
# y reemplaza los valores. terraform.tfvars NO se sube a git.

# El ID de tu cuenta de LABORATORIO. Sácalo con:
#   aws sts get-caller-identity --query Account --output text
lab_account_id = "123456789012"

# Tu IP pública + /32. Sácala con:
#   curl -s https://checkip.amazonaws.com
admin_cidr = "203.0.113.10/32"

region = "us-east-1"
